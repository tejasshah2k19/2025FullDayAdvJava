	<welcome-file-list>
		<welcome-file>GirReg.jsp</welcome-file>
	</welcome-file-list>

	<filter>
		<filter-name>CFilter</filter-name>
		<filter-class>com.filter.CFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>CFilter</filter-name>
		<url-pattern>/ABCController</url-pattern>
	</filter-mapping>

	<filter>
		<filter-name>AFilter</filter-name>
		<filter-class>com.filter.AFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>AFilter</filter-name>
		<url-pattern>/ABCController</url-pattern>
	</filter-mapping>
	<filter>
		<filter-name>BFilter</filter-name>
		<filter-class>com.filter.BFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>BFilter</filter-name>
		<url-pattern>/ABCController</url-pattern>
	</filter-mapping>

